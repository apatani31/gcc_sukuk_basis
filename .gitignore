# credentials -- never commit
secrets.env
.env
lseg-data.config.json
*.config.json

# environment / logs
.venv/
__pycache__/
.pytest_cache/
logs/

# data: this repo is public and LSEG's licence does not allow republishing its
# raw data (prices, yields, CDS, rates, the Workspace universe exports), so
# everything under data/ is ignored except written reports, charts and
# summary-statistic tables. Regenerate the rest with your own LSEG login.
data/**
!data/**/
!data/USD/summary.md
!data/USD/data_dictionary.csv
